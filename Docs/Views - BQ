CREATE OR REPLACE VIEW `bd_dunes.vw_pagamentos` AS
SELECT
-- IDs
TRIM(id_pagamento) AS id_pagamento,
TRIM(id_pedido) AS id_pedido,
TRIM(id_transacao) AS id_transacao,
-- Pagamento
UPPER(TRIM(metodo_pagamento)) AS metodo_pagamento,
UPPER(TRIM(status_pagamento)) AS status_pagamento,
-- Valores
CAST(valor_pagamento AS NUMERIC) AS valor_pagamento,
-- Datas
CAST(data_pagamento AS DATE) AS data_pagamento,
-- Indicadores Financeiros
CASE
WHEN UPPER(TRIM(status_pagamento)) = 'PAGO' THEN 1
ELSE 0
END AS pagamento_aprovado,
CASE
WHEN UPPER(TRIM(status_pagamento)) = 'PENDENTE' THEN 1
ELSE 0
END AS pagamento_pendente,
CASE
WHEN UPPER(TRIM(status_pagamento)) = 'CANCELADO' THEN 1
ELSE 0
END AS pagamento_cancelado,
-- Classificação valor
CASE
WHEN CAST(valor_pagamento AS NUMERIC) >= 10000 THEN 'ALTO_VALOR'
WHEN CAST(valor_pagamento AS NUMERIC) >= 5000 THEN 'MEDIO_VALOR'
ELSE 'BAIXO_VALOR'
END AS faixa_valor_pagamento
FROM `bd_dunes.tb_pagamentos`;

