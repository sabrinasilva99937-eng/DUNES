CREATE OR REPLACE VIEW `bd_dunes.vw_campanhas_marketing` AS
SELECT
-- IDs
TRIM(id_campanha) AS id_campanha,
-- Campanha
INITCAP(TRIM(nome_campanha)) AS nome_campanha,
INITCAP(TRIM(plataforma)) AS plataforma,
-- Valores
CAST(valor_orcamento AS NUMERIC) AS valor_orcamento,
CAST(receita_gerada AS NUMERIC) AS receita_gerada,
-- Métricas
CAST(impressoes AS INT64) AS impressoes,
CAST(cliques AS INT64) AS cliques,
CAST(conversoes AS INT64) AS conversoes,
-- Datas

CAST(data_inicio AS DATE) AS data_inicio,
CAST(data_fim AS DATE) AS data_fim,
-- Duração campanha
DATE_DIFF(
CAST(data_fim AS DATE),
CAST(data_inicio AS DATE),
DAY
) AS dias_campanha,
-- CTR
ROUND(
SAFE_DIVIDE(
CAST(cliques AS FLOAT64),
NULLIF(CAST(impressoes AS FLOAT64),0)
) * 100,
2
) AS ctr_percentual,
-- Taxa conversão
ROUND(
SAFE_DIVIDE(
CAST(conversoes AS FLOAT64),
NULLIF(CAST(cliques AS FLOAT64),0)
) * 100,
2
) AS taxa_conversao_percentual,
-- CPC
ROUND(
SAFE_DIVIDE(
CAST(valor_orcamento AS NUMERIC),
NULLIF(CAST(cliques AS FLOAT64),0)
),
2
) AS custo_por_clique,
-- CPA
ROUND(
SAFE_DIVIDE(
CAST(valor_orcamento AS NUMERIC),
NULLIF(CAST(conversoes AS FLOAT64),0)
),
2

) AS custo_por_conversao,
-- ROAS
ROUND(
SAFE_DIVIDE(
CAST(receita_gerada AS NUMERIC),
NULLIF(CAST(valor_orcamento AS NUMERIC),0)
),
2
) AS roas,
-- ROI
ROUND(
SAFE_DIVIDE(
CAST(receita_gerada AS NUMERIC) - CAST(valor_orcamento AS NUMERIC),
NULLIF(CAST(valor_orcamento AS NUMERIC),0)
) * 100,
2
) AS roi_percentual,
-- Classificação performance
CASE
WHEN SAFE_DIVIDE(
CAST(receita_gerada AS NUMERIC),
NULLIF(CAST(valor_orcamento AS NUMERIC),0)
) >= 4 THEN 'ALTA_PERFORMANCE'
WHEN SAFE_DIVIDE(
CAST(receita_gerada AS NUMERIC),
NULLIF(CAST(valor_orcamento AS NUMERIC),0)
) >= 2 THEN 'MEDIA_PERFORMANCE'
ELSE 'BAIXA_PERFORMANCE'
END AS classificacao_performance
FROM `bd_dunes.tb_campanhas_marketing`;
