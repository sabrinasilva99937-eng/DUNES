CREATE OR REPLACE VIEW `bd_dunes.vw_entregas` AS
SELECT
-- IDs
TRIM(id_entrega) AS id_entrega,
TRIM(id_pedido) AS id_pedido,
-- Logística
INITCAP(TRIM(tranportadora)) AS tranportadora,
UPPER(TRIM(tipo_frete)) AS tipo_frete,
-- Valores
CAST(custo_frete AS NUMERIC) AS custo_frete,
-- Rastreio
TRIM(codigo_rastreio) AS codigo_rastreio,
-- Datas
CAST(data_envio AS DATE) AS data_envio,
CAST(data_entrega AS DATE) AS data_entrega,
-- SLA entrega
DATE_DIFF(
CAST(data_entrega AS DATE),
CAST(data_envio AS DATE),
DAY
) AS dias_entrega,
-- Status
UPPER(TRIM(status_entrega)) AS status_entrega,
-- Classificação SLA
CASE
WHEN DATE_DIFF(
CAST(data_entrega AS DATE),
CAST(data_envio AS DATE),
DAY
) <= 3 THEN 'ENTREGA_RAPIDA'

WHEN DATE_DIFF(
CAST(data_entrega AS DATE),
CAST(data_envio AS DATE),
DAY
) <= 7 THEN 'ENTREGA_NORMAL'
ELSE 'ENTREGA_LENTA'
END AS classificacao_entrega,
-- Faixa custo frete
CASE
WHEN CAST(custo_frete AS NUMERIC) >= 100 THEN 'FRETE_ALTO'
WHEN CAST(custo_frete AS NUMERIC) >= 50 THEN 'FRETE_MEDIO'
ELSE 'FRETE_BAIXO'
END AS faixa_custo_frete
FROM `bd_dunes.tb_entregas`;
