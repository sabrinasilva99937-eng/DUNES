CREATE OR REPLACE VIEW `bd_dunes.vw_itens_pedido` AS
SELECT
-- IDs
TRIM(id_item_pedido) AS id_item_pedido,
TRIM(id_pedido) AS id_pedido,
TRIM(id_produto) AS id_produto,
-- Quantidade
CAST(quantidade AS INT64) AS quantidade,
-- Valores
CAST(preco_unitario AS NUMERIC) AS preco_unitario,
CAST(preco_total AS NUMERIC) AS preco_total,
-- Indicadores
ROUND(
CAST(preco_total AS NUMERIC) -
(
CAST(preco_unitario AS NUMERIC) *
CAST(quantidade AS INT64)
),
2
) AS diferenca_calculo,
ROUND(
SAFE_DIVIDE(
CAST(preco_total AS NUMERIC),
NULLIF(CAST(quantidade AS INT64),0)
),
2
) AS ticket_medio_item,
-- Classificação quantidade
CASE
WHEN CAST(quantidade AS INT64) >= 5 THEN 'COMPRA_GRANDE'
WHEN CAST(quantidade AS INT64) >= 3 THEN 'COMPRA_MEDIA'
ELSE 'COMPRA_PEQUENA'
END AS faixa_quantidade

FROM `bd_dunes.tb_itens_pedido`;
