CREATE OR REPLACE VIEW `bd_dunes.vw_produtos` AS
SELECT
-- IDs
TRIM(id_produto) AS id_produto,
TRIM(sku) AS sku,
TRIM(id_parceiro_fornecedor) AS id_parceiro_fornecedor,
-- Produto
INITCAP(TRIM(nome_produto)) AS nome_produto,
INITCAP(TRIM(categoria)) AS categoria,
INITCAP(TRIM(subcategoria)) AS subcategoria,
INITCAP(TRIM(colecao)) AS colecao,
-- Características
INITCAP(TRIM(material)) AS material,
INITCAP(TRIM(pedra_preciosa)) AS pedra_preciosa,
INITCAP(TRIM(cor)) AS cor,
-- Medidas
CAST(quilates_pedra AS FLOAT64) AS quilates_pedra,
CAST(peso_gramas AS FLOAT64) AS peso_gramas,
CAST(tamanho_aro AS INT64) AS tamanho_aro,
-- Valores
CAST(preco_custo AS NUMERIC) AS preco_custo,
CAST(preco_venda AS NUMERIC) AS preco_venda,
-- Margem

ROUND(
CAST(preco_venda AS NUMERIC) - CAST(preco_custo AS NUMERIC),
2
) AS lucro_bruto,
ROUND(
SAFE_DIVIDE(
CAST(preco_venda AS NUMERIC) - CAST(preco_custo AS NUMERIC),
NULLIF(CAST(preco_venda AS NUMERIC),0)
)*100,
2
) AS margem_percentual,
-- Estoque
CAST(quantidade_estoque AS INT64) AS quantidade_estoque,
CAST(estoque_minimo AS INT64) AS estoque_minimo,
CASE
WHEN CAST(quantidade_estoque AS INT64) = 0 THEN 'SEM_ESTOQUE'
WHEN CAST(quantidade_estoque AS INT64) <= CAST(estoque_minimo AS INT64) THEN
'BAIXO_ESTOQUE'
ELSE 'ESTOQUE_OK'
END AS status_estoque,
-- Localização
INITCAP(TRIM(localizacao_estoque)) AS localizacao_estoque,
-- Certificação
UPPER(TRIM(possui_certificado)) AS possui_certificado,
-- Garantia
CAST(garantia_mes AS INT64) AS garantia_mes,
-- Status
UPPER(TRIM(status_produto)) AS status_produto,
-- Datas
CAST(data_cadastro AS DATE) AS data_cadastro
FROM `bd_dunes.tb_produto`;
