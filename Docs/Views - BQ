CREATE OR REPLACE VIEW `bd_dunes.vw_devolucoes` AS
SELECT
-- IDs
TRIM(id_devolucao) AS id_devolucao,
TRIM(id_pedido) AS id_pedido,
TRIM(id_produto) AS id_produto,
-- Devolução
INITCAP(TRIM(motivo_devolucao)) AS motivo_devolucao,
UPPER(TRIM(status_devolucao)) AS status_devolucao,
-- Datas
CAST(data_solicitacao AS DATE) AS data_solicitacao,
CAST(data_conclusao AS DATE) AS data_conclusao,
-- SLA devolução
DATE_DIFF(
CAST(data_conclusao AS DATE),
CAST(data_solicitacao AS DATE),
DAY

) AS dias_resolucao,
-- Indicadores
CASE
WHEN UPPER(TRIM(status_devolucao)) = 'APROVADA' THEN 1
ELSE 0
END AS devolucao_aprovada,
CASE
WHEN UPPER(TRIM(status_devolucao)) = 'PENDENTE' THEN 1
ELSE 0
END AS devolucao_pendente,
CASE
WHEN UPPER(TRIM(status_devolucao)) = 'RECUSADA' THEN 1
ELSE 0
END AS devolucao_recusada,
-- Classificação SLA
CASE
WHEN DATE_DIFF(
CAST(data_conclusao AS DATE),
CAST(data_solicitacao AS DATE),
DAY
) <= 3 THEN 'RESOLUCAO_RAPIDA'
WHEN DATE_DIFF(
CAST(data_conclusao AS DATE),
CAST(data_solicitacao AS DATE),
DAY
) <= 7 THEN 'RESOLUCAO_NORMAL'
