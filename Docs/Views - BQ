CREATE OR REPLACE VIEW `bd_dunes.vw_pedidos` AS
SELECT
-- IDs
TRIM(id_pedido) AS id_pedido,
TRIM(id_cliente) AS id_cliente,
TRIM(id_parceiro) AS id_parceiro,

-- Datas
CAST(data_pedido AS DATE) AS data_pedido,
CAST(data_entrega AS DATE) AS data_entrega,
-- Tempo entrega
DATE_DIFF(
CAST(data_entrega AS DATE),
CAST(data_pedido AS DATE),
DAY
) AS dias_entrega,
-- Status
UPPER(TRIM(status_pedido)) AS status_pedido,
UPPER(TRIM(status_entrega)) AS status_entrega,
-- Pagamento
UPPER(TRIM(metodo_pagamento)) AS metodo_pagamento,
-- Valores
CAST(valor_subtotal AS NUMERIC) AS valor_subtotal,
CAST(valor_frete AS NUMERIC) AS valor_frete,
CAST(valor_desconto AS NUMERIC) AS valor_desconto,
CAST(valor_total AS NUMERIC) AS valor_total,
CAST(valor_comissao_parceiro AS NUMERIC) AS valor_comissao_parceiro,
-- Indicadores
ROUND(
SAFE_DIVIDE(
CAST(valor_desconto AS NUMERIC),
NULLIF(CAST(valor_subtotal AS NUMERIC),0)
)*100,
2
) AS percentual_desconto,
ROUND(
SAFE_DIVIDE(
CAST(valor_frete AS NUMERIC),
NULLIF(CAST(valor_total AS NUMERIC),0)
)*100,
2
) AS percentual_frete,
ROUND(
SAFE_DIVIDE(

CAST(valor_comissao_parceiro AS NUMERIC),
NULLIF(CAST(valor_total AS NUMERIC),0)
)*100,
2
) AS percentual_comissao,
-- Logística
TRIM(codigo_rastreio) AS codigo_rastreio
FROM `bd_dunes.tb_pedidos`;
