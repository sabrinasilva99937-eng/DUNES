CREATE OR REPLACE VIEW `bd_dunes.vw_kpi_clientes` AS
SELECT
-- Cliente
id_cliente,
nome_completo,
idade,
cidade_cliente,
estado_cliente,
canal_aquisicao,
-- Métricas
COUNT(DISTINCT id_pedido) AS total_pedidos,
ROUND(
SUM(valor_total),
2
) AS faturamento_cliente,
ROUND(
AVG(valor_total),
2
) AS ticket_medio_cliente,
ROUND(
MAX(valor_total),
2
) AS maior_compra,
ROUND(
MIN(valor_total),
2
) AS menor_compra,
-- Produtos
SUM(quantidade) AS total_itens_comprados,
COUNT(DISTINCT id_produto) AS produtos_diferentes,
-- Datas
MIN(data_pedido) AS primeira_compra,
MAX(data_pedido) AS ultima_compra,

DATE_DIFF(
CURRENT_DATE(),
MAX(data_pedido),
DAY
) AS dias_ultima_compra,
-- Segmentação cliente
CASE
WHEN SUM(valor_total) >= 50000 THEN 'CLIENTE_VIP'
WHEN SUM(valor_total) >= 20000 THEN 'CLIENTE_PREMIUM'
WHEN SUM(valor_total) >= 5000 THEN 'CLIENTE_FREQUENTE'
ELSE 'CLIENTE_COMUM'
END AS categoria_cliente
FROM `bd_dunes.vw_fato_vendas`
GROUP BY
id_cliente,
nome_completo,
idade,
cidade_cliente,
estado_cliente,
canal_aquisicao;
