CREATE OR REPLACE VIEW `bd_dunes.vw_kpi_marketing` AS
SELECT
-- Campanha
id_campanha,
nome_campanha,
plataforma,
-- Datas
data_inicio,
data_fim,
dias_campanha,
EXTRACT(YEAR FROM data_inicio) AS ano,
EXTRACT(MONTH FROM data_inicio) AS mes,
-- Investimento
valor_orcamento,
-- Métricas
impressoes,
cliques,
conversoes,
receita_gerada,
-- KPIs
ctr_percentual,
taxa_conversao_percentual,

custo_por_clique,
custo_por_conversao,
roas,
roi_percentual,
-- CAC estimado
ROUND(
SAFE_DIVIDE(
valor_orcamento,
NULLIF(conversoes,0)
),
2
) AS cac_estimado,
-- Receita por clique
ROUND(
SAFE_DIVIDE(
receita_gerada,
NULLIF(cliques,0)
),
2
) AS receita_por_clique,
-- Receita por impressão
ROUND(
SAFE_DIVIDE(
receita_gerada,
NULLIF(impressoes,0)
),
4
) AS receita_por_impressao,
-- Classificação campanha
CASE
WHEN roas >= 5 THEN 'CAMPANHA_ESCALAVEL'
WHEN roas >= 3 THEN 'CAMPANHA_LUCRATIVA'
WHEN roas >= 1 THEN 'CAMPANHA_ESTAVEL'
ELSE 'CAMPANHA_NEGATIVA'
END AS classificacao_campanha

FROM `bd_dunes.vw_campanhas_marketing`;
