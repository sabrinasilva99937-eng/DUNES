-------------------------------------------------------------------
CREATE OR REPLACE VIEW `bd_dunes.vw_kpi_marketplace` AS
SELECT
-- Parceiro
id_parceiro,
nome_fantasia,
razao_social,
-- Localização
cidade,

estado,
latitude,
longitude,
-- Comissão
percentual_comissao,
faixa_comissao,
-- Status
status_parceria,
classificacao_parceria,
-- Tempo parceria
dias_parceria,
-- Produtos
COUNT(DISTINCT id_produto) AS total_produtos,
COUNT(DISTINCT categoria) AS categorias_ativas,
-- Pedidos
COUNT(DISTINCT id_pedido) AS total_pedidos,
-- Clientes
COUNT(DISTINCT id_cliente) AS clientes_unicos,
-- Receita
ROUND(
SUM(valor_total),
2
) AS faturamento_parceiro,
ROUND(
AVG(valor_total),
2
) AS ticket_medio_parceiro,
-- Comissão total
ROUND(
SUM(valor_comissao_parceiro),
2
) AS comissao_total,
-- Lucro operacional

ROUND(
SUM(
valor_total -
(preco_custo * quantidade) -
valor_comissao_parceiro
),
2
) AS lucro_operacional_parceiro,
-- Produtos vendidos
SUM(quantidade) AS total_itens_vendidos,
-- Datas
MIN(data_pedido) AS primeira_venda,
MAX(data_pedido) AS ultima_venda,
DATE_DIFF(
CURRENT_DATE(),
MAX(data_pedido),
DAY
) AS dias_ultima_venda,
-- Performance parceiro
CASE
WHEN SUM(valor_total) >= 500000 THEN 'PARCEIRO_ELITE'
WHEN SUM(valor_total) >= 200000 THEN 'PARCEIRO_PREMIUM'
WHEN SUM(valor_total) >= 50000 THEN 'PARCEIRO_DESTAQUE'
ELSE 'PARCEIRO_PADRAO'
END AS classificacao_performance
FROM `bd_dunes.vw_fato_vendas`
GROUP BY
id_parceiro,
nome_fantasia,
razao_social,
cidade,
estado,

latitude,
longitude,
percentual_comissao,
faixa_comissao,
status_parceria,
classificacao_parceria,
dias_paceria.
