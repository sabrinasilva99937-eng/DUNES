SELECT *
FROM `bd_dunes.tb_certificados_produtos`;
-- LIMPESA DOS DADOS:
----------------------------------------------------------------------------------------------------
SELECT

-- IDs
TRIM(id_certificado) AS id_certificado,
TRIM(id_produto) AS id_produto,
-- Certificado
UPPER(TRIM(numero_certificado)) AS numero_certificado,
-- Datas
CAST(data_emissao AS DATE) AS data_emissao,
CAST(data_expiracao AS DATE) AS data_expiracao,
-- Métrica útil
