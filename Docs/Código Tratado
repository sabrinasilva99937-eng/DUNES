Código limpeza dos dados:
-- SELECT DA TABELA:
----------------------------------------------------------------------------------------------------
SELECT *
FROM `bd_dunes.tb_clientes`;
-- LIMPESA DOS DADOS:
----------------------------------------------------------------------------------------------------
SELECT
-- IDs
TRIM(id_cliente) AS id_cliente,
-- Nome
INITCAP(TRIM(primeiro_nome)) AS primeiro_nome,
INITCAP(TRIM(sobrenome)) AS sobrenome,
-- Contato
LOWER(TRIM(email)) AS email,
TRIM(telefone) AS telefone,
-- Documento
TRIM(cpf) AS cpf,
-- Datas
CAST(data_nascimento AS DATE) AS data_nascimento,
CAST(data_cadastro AS DATE) AS data_cadastro,
-- Localização
INITCAP(TRIM(cidade)) AS cidade,
UPPER(TRIM(estado)) AS estado,
CAST(latitude AS FLOAT64) AS latitude,
CAST(longitude AS FLOAT64) AS longitude,
-- Marketing
INITCAP(TRIM(canal_aquisicao)) AS canal_aquisicao,
-- Métricas

CAST(total_pedidos AS INT64) AS total_pedidos,
CAST(valor_total_gasto AS NUMERIC) AS valor_total_gasto
FROM `bd_dunes.tb_clientes`;
-- SELECT DA TABELA:
----------------------------------------------------------------------------------------------------
SELECT *
FROM `bd_dunes.tb_pedidos`;

-- LIMPESA DOS DADOS:
----------------------------------------------------------------------------------------------------
SELECT
-- IDs
TRIM(id_pedido) AS id_pedido,
TRIM(id_cliente) AS id_cliente,
TRIM(id_parceiro) AS id_parceiro,
-- Datas
CAST(data_pedido AS DATE) AS data_pedido,
CAST(data_entrega AS DATE) AS data_entrega,
-- Status
UPPER(TRIM(status_pedido)) AS status_pedido,
UPPER(TRIM(status_entrega)) AS status_entrega,
-- Pagamento
UPPER(TRIM(metodo_pagamento)) AS metodo_pagamento,
-- Valores
CAST(valor_subtotal AS NUMERIC) AS valor_subtotal,
CAST(valor_frete AS NUMERIC) AS valor_frete,
CAST(valor_desconto AS NUMERIC) AS valor_desconto,
CAST(valor_total AS NUMERIC) AS valor_total,
CAST(valor_comissao_parceiro AS NUMERIC) AS valor_comissao_parceiro,
-- Logística
TRIM(codigo_rastreio) AS codigo_rastreio
FROM `bd_dunes.tb_pedidos`;

