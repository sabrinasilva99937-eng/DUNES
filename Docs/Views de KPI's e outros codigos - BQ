CREATE OR REPLACE VIEW `bd_dunes.vw_kpi_logistica` AS

SELECT

-- Entrega
id_entrega,
id_pedido,

-- Transportadora
tranportadora,
tipo_frete,

-- Datas
data_envio,
data_entrega,

EXTRACT(YEAR FROM data_envio) AS ano,
EXTRACT(MONTH FROM data_envio) AS mes,

-- SLA
dias_entrega,
classificacao_entrega,

-- Custos
custo_frete,
faixa_custo_frete,

-- Status
status_entrega,

-- Indicadores
CASE
WHEN status_entrega = 'ENTREGUE' THEN 1
ELSE 0
END AS entrega_concluida,

CASE
WHEN dias_entrega > 7 THEN 1
ELSE 0
END AS entrega_atrasada,

CASE
WHEN dias_entrega <= 3 THEN 1
ELSE 0
END AS entrega_rapida,

-- Eficiência logística
ROUND(
SAFE_DIVIDE(
custo_frete,
NULLIF(dias_entrega,0)
),
2
) AS custo_por_dia_entrega,

-- Classificação operacional
CASE

WHEN dias_entrega <= 2 THEN 'OPERACAO_EFICIENTE'

WHEN dias_entrega <= 5 THEN 'OPERACAO_NORMAL'

ELSE 'OPERACAO_LENTA'

END AS eficiencia_operacional

FROM `bd_dunes.vw_entregas`;

