CREATE OR REPLACE VIEW `bd_dunes.vw_kpi_produtos` AS

SELECT

-- Produto
id_produto,
nome_produto,
categoria,
subcategoria,
colecao,
material,
pedra_preciosa,

-- Estoque
status_estoque,
quantidade_estoque,

-- Valores
preco_custo,
preco_venda,
lucro_bruto,
margem_percentual,

-- Vendas
COUNT(DISTINCT id_pedido) AS total_pedidos,

SUM(quantidade) AS total_itens_vendidos,

ROUND(
SUM(preco_total),
2
) AS faturamento_produto,

ROUND(
SUM(
preco_total - (preco_custo * quantidade)
),
2
) AS lucro_total_produto,

ROUND(
AVG(preco_total),
2
) AS ticket_medio_produto,

-- Datas
MIN(data_pedido) AS primeira_venda,
MAX(data_pedido) AS ultima_venda,

DATE_DIFF(
CURRENT_DATE(),
MAX(data_pedido),
DAY
) AS dias_ultima_venda,

-- Performance produto
CASE

WHEN SUM(preco_total) >= 100000 THEN 'BEST_SELLER'

WHEN SUM(preco_total) >= 50000 THEN 'ALTA_PERFORMANCE'

WHEN SUM(preco_total) >= 10000 THEN 'MEDIA_PERFORMANCE'

ELSE 'BAIXA_PERFORMANCE'

END AS classificacao_produto

FROM `bd_dunes.vw_fato_vendas`

GROUP BY

id_produto,
nome_produto,
categoria,
subcategoria,
colecao,
material,
pedra_preciosa,
status_estoque,
quantidade_estoque,
preco_custo,
preco_venda,
lucro_bruto,
margem_percentual;

