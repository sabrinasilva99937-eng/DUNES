CREATE OR REPLACE VIEW `bd_dunes.vw_kpi_financeiro` AS

SELECT

-- Data
data_pedido,

EXTRACT(YEAR FROM data_pedido) AS ano,
EXTRACT(MONTH FROM data_pedido) AS mes,
EXTRACT(WEEK FROM data_pedido) AS semana,

-- Pedidos
COUNT(DISTINCT id_pedido) AS total_pedidos,

-- Clientes
COUNT(DISTINCT id_cliente) AS clientes_unicos,

-- Produtos
COUNT(DISTINCT id_produto) AS produtos_vendidos,

SUM(quantidade) AS total_itens_vendidos,

-- Receita
ROUND(
SUM(valor_total),
2
) AS faturamento_total,

ROUND(
AVG(valor_total),
2
) AS ticket_medio,

ROUND(
MAX(valor_total),
2
) AS maior_venda,

ROUND(
MIN(valor_total),
2
) AS menor_venda,

-- Custos
ROUND(
SUM(preco_custo * quantidade),
2
) AS custo_total_produtos,

ROUND(
SUM(valor_frete),
2
) AS custo_total_frete,

ROUND(
SUM(valor_comissao_parceiro),
2
) AS total_comissao_parceiros,

-- Lucro
ROUND(
SUM(
valor_total -
(preco_custo * quantidade) -
valor_comissao_parceiro -
valor_frete
),
2
) AS lucro_operacional,

-- Margem
ROUND(
SAFE_DIVIDE(
SUM(
valor_total -
(preco_custo * quantidade) -
valor_comissao_parceiro -
valor_frete
),
NULLIF(SUM(valor_total),0)
) * 100,
2
) AS margem_operacional_percentual,

-- Desconto
ROUND(
SUM(valor_desconto),
2
) AS total_descontos,

-- Pagamentos
COUNTIF(status_pagamento = 'PAGO') AS pagamentos_aprovados,
COUNTIF(status_pagamento = 'PENDENTE') AS pagamentos_pendentes,
COUNTIF(status_pagamento = 'CANCELADO') AS pagamentos_cancelados,

-- SLA
ROUND(
AVG(dias_entrega),
2
) AS media_dias_entrega

FROM `bd_dunes.vw_fato_vendas`

GROUP BY

data_pedido,
ano,
mes,
semana;

